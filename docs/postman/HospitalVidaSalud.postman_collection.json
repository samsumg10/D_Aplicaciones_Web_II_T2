                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/citas/{{citaId}}/estado",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "citas",
                "{{citaId}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"PENDIENTE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
