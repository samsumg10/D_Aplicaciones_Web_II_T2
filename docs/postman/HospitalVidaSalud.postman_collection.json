                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/citas/{{citaId}}/estado",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "citas",
                "{{citaId}}",
                "estado"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CONFIRMADA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "08 Transición no permitida CONFIRMADA -> PENDIENTE (409 RN-06)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 409\", () => pm.response.to.have.status(409));"
                ]
