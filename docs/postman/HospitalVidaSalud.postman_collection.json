    {
      "name": "02 Citas",
      "item": [
        {
          "name": "05 Registrar cita (valida al paciente vía Eureka)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) { pm.collectionVariables.set(\"citaId\", pm.response.json().id); }"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Próximo lunes a las 10:00 y un profesional aleatorio (evita chocar con ejecuciones anteriores)",
                  "const d = new Date();",
                  "d.setDate(d.getDate() + (((8 - d.getDay()) % 7) || 7));",
                  "const f = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');",
                  "pm.collectionVariables.set('fechaCita', f + 'T10:00:00');",
                  "pm.collectionVariables.set('profesional', 'CAR-' + (100 + Math.floor(Math.random() * 900)));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{gateway}}/api/citas",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pacienteId\": {{pacienteId}},\n  \"especialidad\": \"CARDIOLOGIA\",\n  \"fechaHora\": \"{{fechaCita}}\",\n  \"profesionalCodigo\": \"{{profesional}}\",\n  \"motivo\": \"Control administrativo\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "06 Consultar cita",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway}}/api/citas/{{citaId}}",
              "host": [
                "{{gateway}}"
              ],
              "path": [
                "api",
                "citas",
                "{{citaId}}"
              ]
            }
          }
