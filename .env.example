# Plantilla de variables de entorno para desarrollo local.
# 1) Copie este archivo como .env en la misma carpeta (la raíz del workspace).
# 2) Cambie las contraseñas. El archivo .env está en .gitignore y NUNCA se sube al repositorio.
# Lo leen docker-compose.yml (para crear PostgreSQL y RabbitMQ) y cada microservicio
# (spring.config.import=optional:file:../.env[.properties]). No use comillas en los valores.

# PostgreSQL (docker-compose lo publica en el puerto 5433 para no chocar con un PostgreSQL local en 5432)
DB_HOST=localhost
DB_PORT=5433
DB_USER=hospital
DB_PASSWORD=cambie_esta_clave

# RabbitMQ (panel de administración en http://localhost:15672)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=hospital
RABBITMQ_PASSWORD=cambie_esta_clave
